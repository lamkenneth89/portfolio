---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../lib/site';
import ProfileCard from '../components/ProfileCard.astro';

const timeline = [
  {
    period: '2025 – 2026',
    org: 'Standard Chartered Bank',
    role: 'Associate Director, Digital Analytics & Performance Management',
    what: 'Digital analytics across paid, owned and earned media, and the infrastructure underneath it: a CDP giving a single view of the customer, a tagging and measurement framework spanning twenty product journeys, and onboarding funnel analysis that turned drop-off into a product and risk conversation rather than a reporting line. Worked across Legal, Compliance, Risk and Product.',
  },
  {
    period: '2024 – 2025',
    org: 'Independent projects',
    role: 'Six months between roles',
    what: 'Professional Scrum Master I and Alteryx Designer Core, Google IT Automation with Python, the Google and Kaggle GenAI intensive, and the Databricks LLMs in Production course. Shipped the minibus scraper, ran a social platform landscape study, and built the first version of this site.',
  },
  {
    period: '2022 – 2024',
    org: 'Dyson',
    role: 'Senior Manager — Insights, Analytics & CRM, Hong Kong & Taiwan',
    what: 'Owned the CRM P&L and a team of three. Grew the CRM base fivefold and pushed incremental repurchase past 20% through K-Means segmentation and continuous campaign optimisation; rebuilt the customer journey across e-commerce, CRM and service; revamped the data architecture so the market stopped waiting on region for an extract.',
  },
  {
    period: '2021 – 2022',
    org: 'Viu (PCCW OTT)',
    role: 'Business Analytics Lead, Greater Southeast Asia',
    what: 'Retention and advertising analytics for a regional streaming business. Churn propensity scoring feeding retargeting and app push, an organic traffic tracker, and a UTM naming standard agreed across product, marketing and data. Scrum Master on the recommendation engine revamp, and founded the company’s Analytics Guild.',
  },
  {
    period: '2018 – 2021',
    org: 'Mattel',
    role: 'APAC Data & Insights Lead',
    what: 'Market audits across APAC with SEO and customer-experience recommendations, media mix modelling to reallocate spend, a data repository with automated ETL, and social listening and POS mining feeding multi-brand go-to-market.',
  },
  {
    period: '2013 – 2018',
    org: 'PCCW HKT',
    role: 'Market Planning Manager',
    what: 'Revenue targets and ROI measurement frameworks for broadband and cloud services, customer portfolio and competitor analysis, pricing strategy, and the launch of a cloud storage product. Team of two, split between business planning and product marketing.',
  },
  {
    period: '2010 – 2013',
    org: 'TNS Hong Kong',
    role: 'Senior Research Executive',
    what: 'Brand tracking, NPS, mystery shopping and customer experience studies across finance, IT and telecoms, coordinating stakeholders across several countries. Where the research discipline came from.',
  },
];
---

<Base
  title={`About — ${site.name}`}
  description="Kenneth Lam — analytics, CRM and AI-assisted engineering in Hong Kong."
>
  <div class="mx-auto max-w-[76rem] px-5 sm:px-8">
    <section class="grid gap-10 pb-16 pt-16 md:grid-cols-12 md:pt-24">
      <div class="md:col-span-8">
        <p class="kicker">About</p>
        <h1 class="mt-5 text-[clamp(2.4rem,6vw,4.2rem)]">
          Fifteen years of asking what the number actually means.
        </h1>
        <div class="prose-dossier mt-9 text-lg">
          <p>
            I lead analytics work that has to survive contact with a commercial
            team: segmentation that changes who gets contacted, dashboards
            people open on a Monday morning, research that settles an argument
            about which product to launch. Most recently that has been in
            digital banking — funnel friction, a single view of the customer,
            and measurement treated as infrastructure rather than reporting.
            Before that, at Dyson, Viu and Mattel, it meant growing a CRM base
            fivefold, pushing incremental repurchase past 20%, and rebuilding
            the data architecture underneath so a market could stop waiting on
            region for an extract.
          </p>
          <p>
            The part that changed recently is the building. For most of my
            career I specified systems and someone else wrote them. Over the
            last year I have been writing them — a trilingual speech
            transcription and summarisation service, an Android app
            instrumented end to end to learn mobile measurement properly, a
            small game shipped to the web, dashboards and graph tooling — with
            an AI pair doing the typing and me doing the deciding.
          </p>
          <p>
            That has made me a better analytics lead, not a worse one. Knowing
            what it costs to emit an event correctly changes how you write a
            tracking spec. Watching a tag configuration produce 1,571 events in
            one session because a trigger was too broad is a different kind of
            education from reading about it.
          </p>
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={site.resume}
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
            data-track="resume_download"
          >
            Download résumé ↗
          </a>
          <a
            href="https://public.tableau.com/app/profile/kenneth.lam/viz/Resume_17168221183140/CV"
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
          >
            Résumé as a Tableau viz ↗
          </a>
        </div>
      </div>

      <aside class="md:col-span-4">
        <ProfileCard withFacts={false} />
      </aside>
    </section>

    <section class="pb-20">
      <SectionHead num="01" label="Where" title="Career" />
      <dl class="mt-10 border-t border-rule">
        {
          timeline.map((t) => (
            <div class="grid gap-2 border-b border-rule py-6 md:grid-cols-12 md:gap-6">
              <dt class="kicker pt-1 md:col-span-2">{t.period}</dt>
              <dd class="md:col-span-10">
                <p class="font-display text-3xl leading-none">{t.org}</p>
                <p class="mt-1.5 text-[0.95rem] font-semibold text-accent">
                  {t.role}
                </p>
                <p class="mt-3 max-w-[62ch] text-fg-muted">{t.what}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="pb-24">
      <SectionHead num="02" label="How" title="How I work" />
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        <div class="panel p-6">
          <h3 class="kicker">Start from the decision</h3>
          <p class="mt-4 text-fg-muted">
            A metric nobody would act on differently is a metric not worth
            building. I would rather ship three numbers a team uses than thirty
            it admires.
          </p>
        </div>
        <div class="panel p-6">
          <h3 class="kicker">Instrument before you analyse</h3>
          <p class="mt-4 text-fg-muted">
            Most analytics problems are collection problems wearing a costume.
            Tracking specs, naming conventions and validation belong at the
            start, not after the first report disappoints.
          </p>
        </div>
        <div class="panel p-6">
          <h3 class="kicker">Build the small version</h3>
          <p class="mt-4 text-fg-muted">
            A working prototype settles arguments that a document extends.
            Certified Professional Scrum Master, which mostly means I know when
            the ceremony is helping and when it is not.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
