---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import FeaturedEntry from '../components/FeaturedEntry.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site, facts } from '../lib/site';
import { url, imageSet } from '../lib/url';
import { CATEGORIES } from '../content.config';

const all = await getCollection('projects');
const sorted = [...all].sort((a, b) => a.data.order - b.data.order);
const featured = sorted
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.featuredRank - b.data.featuredRank);

// The heading counts what is actually featured, so adding a project in a later
// phase can never leave the page claiming the wrong number.
const NUMBER_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six'];
const featuredWord = NUMBER_WORDS[featured.length] ?? String(featured.length);

const byCategory = CATEGORIES.map((category) => ({
  category,
  items: sorted.filter((p) => p.data.category === category),
})).filter((g) => g.items.length > 0);

const capabilities = [
  {
    heading: 'Data & cloud',
    items: ['Python', 'SQL', 'GCP BigQuery', 'Databricks', 'Alteryx'],
  },
  {
    heading: 'Analysis & visualisation',
    items: ['Tableau', 'Power BI', 'Looker', 'Excel'],
  },
  {
    heading: 'Martech & CRM',
    items: [
      'Adobe Experience Cloud',
      'Salesforce',
      'GA4',
      'Google Tag Manager',
      'Firebase Analytics',
    ],
  },
  {
    heading: 'Build & AI',
    items: [
      'Claude Code',
      'Astro',
      'Kotlin / Compose',
      'Streamlit',
      'Godot',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Analytics & CRM lead',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  url: new URL(url('/'), Astro.site).href,
  sameAs: site.socials.map((s) => s.href),
};
---

<Base title={`${site.name} — ${site.role}`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-[76rem] px-5 sm:px-8">
    <!-- ── Hero ───────────────────────────────────────────────────────── -->
    <section
      class="grid items-center gap-12 pb-24 pt-14 md:grid-cols-12 md:gap-14 md:pt-24"
    >
      <div class="md:col-span-7 lg:col-span-8">
        <p class="reveal" style="--i:0">
          <span class="chip">Analytics · CRM · AI-assisted engineering</span>
        </p>

        <h1
          class="reveal mt-6 text-[clamp(2.5rem,6.2vw,4.6rem)]"
          style="--i:1"
        >
          I turn messy customer data into decisions{' '}
          <em class="text-accent">— and, lately, into software that ships.</em>
        </h1>

        <p
          class="reveal mt-7 max-w-[58ch] text-[1.12rem] text-fg-muted"
          style="--i:2"
        >
          Fifteen years of consumer insight, business intelligence and CRM at
          Dyson, PCCW and Mattel — doubling a CRM base in a year, and lifting
          incremental repurchase past 20% by treating segmentation as an
          operating system rather than a slide. The last year has been spent
          building the things I used to specify: speech pipelines, instrumented
          mobile apps, dashboards and a game, most of them written alongside an
          AI pair.
        </p>

        <div class="reveal mt-9 flex flex-wrap gap-3" style="--i:3">
          <a
            href={site.resume}
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
            data-track="resume_download"
          >
            Download résumé ↗
          </a>
          <a href="#work" class="btn btn-ghost">See selected work ↓</a>
        </div>
      </div>

      <!-- Profile card -->
      <aside class="reveal md:col-span-5 lg:col-span-4" style="--i:4">
        <div class="panel px-6 pb-5 pt-8 text-center shadow-[0_18px_40px_-28px_rgb(30_20_12/0.35)]">
          <div
            class="mx-auto w-40 rounded-full bg-gradient-to-br from-brand to-[#f4b680] p-[5px] md:w-44"
          >
            <img
              {...imageSet('/images/avatar.jpg')}
              sizes="176px"
              alt={`Portrait of ${site.name}`}
              width="1024"
              height="1024"
              class="aspect-square w-full rounded-full border-4 border-surface object-cover"
            />
          </div>
          <p class="mt-4 font-display text-2xl">{site.name}</p>
          <p class="text-[0.92rem] text-fg-muted">{site.location}</p>

          <dl class="mt-5 text-left">
            {
              facts.map((f) => (
                <div class="flex justify-between gap-4 border-t border-rule py-2.5">
                  <dt class="kicker pt-0.5">{f.label}</dt>
                  <dd class="text-right text-[0.93rem]">{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </section>

    <!-- ── Selected work ──────────────────────────────────────────────── -->
    <section id="work" class="scroll-mt-20 pb-24" data-section="work">
      <SectionHead
        num="01"
        label="Selected work"
        title={`${featuredWord.charAt(0).toUpperCase()}${featuredWord.slice(1)} that show the range`}
        note={`${sorted.length} projects in the index`}
      />
      <div class="mt-12 space-y-20">
        {
          featured.map((project, i) => (
            <FeaturedEntry project={project} index={i} />
          ))
        }
      </div>
    </section>

    <!-- ── Full index ─────────────────────────────────────────────────── -->
    <section id="index" class="scroll-mt-20 pb-24" data-section="index">
      <SectionHead num="02" label="Index" title="Everything, by discipline" />
      <div class="mt-10 space-y-8">
        {
          byCategory.map((group) => (
            <div class="panel px-5 pb-2 pt-5 sm:px-7">
              <h3 class="kicker flex items-center justify-between">
                {group.category}
                <span class="chip">{group.items.length}</span>
              </h3>
              <ol class="mt-2">
                {group.items.map((project, i) => (
                  <ProjectRow project={project} index={i} />
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Capabilities ───────────────────────────────────────────────── -->
    <section
      id="capabilities"
      class="scroll-mt-20 pb-24"
      data-section="capabilities"
    >
      <SectionHead num="03" label="Capabilities" title="The toolkit" />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((c) => (
            <div class="panel p-6">
              <h3 class="kicker">{c.heading}</h3>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {c.items.map((item) => (
                  <li class="rounded-full border border-rule-strong bg-surface px-3 py-1 text-[0.9rem]">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Contact ────────────────────────────────────────────────────── -->
    <section id="contact" class="scroll-mt-20 pb-16" data-section="contact">
      <SectionHead num="04" label="Contact" title="Get in touch" />
      <div class="mt-10 grid gap-8 md:grid-cols-12">
        <form id="contact-form" class="panel p-6 sm:p-8 md:col-span-7">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="kicker">Name</span>
              <input type="text" name="name" required class="field mt-2" />
            </label>
            <label class="block">
              <span class="kicker">Email</span>
              <input type="email" name="email" required class="field mt-2" />
            </label>
          </div>
          <label class="mt-4 block">
            <span class="kicker">Message</span>
            <textarea name="message" rows="5" required class="field mt-2"
            ></textarea>
          </label>
          <button type="submit" class="btn btn-primary mt-5">
            Open in mail client →
          </button>
          <p class="mt-3 text-[0.86rem] text-fg-faint">
            This form composes a message in your own mail app — nothing is sent
            to a server, and nothing is stored here.
          </p>
        </form>

        <div class="md:col-span-5">
          <p class="font-display text-[clamp(1.5rem,2.8vw,2rem)] leading-snug">
            Happiest on problems where the data is messy, the stakeholders
            disagree, and someone still has to decide.
          </p>
          <ul class="mt-7">
            <li class="flex justify-between border-t border-rule py-3">
              <span class="kicker pt-0.5">Email</span>
              <a
                href={`mailto:${site.email}`}
                class="text-[0.95rem] text-accent hover:underline"
                data-track="contact_submit"
                data-contact-method="mailto_link">{site.email}</a
              >
            </li>
            {
              site.socials.map((s) => (
                <li class="flex justify-between border-t border-rule py-3">
                  <span class="kicker pt-0.5">{s.label}</span>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener"
                    class="text-[0.95rem] text-accent hover:underline"
                  >
                    Visit ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { track } from '../lib/track';

  // The contact form has no backend by design — it hands the draft to the
  // visitor's own mail client, exactly as the previous site did.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    // Only the channel is recorded — never the name, address or message.
    track('contact_submit', { contact_method: 'form' });
    const data = new FormData(form);
    const name = String(data.get('name') ?? '');
    const email = String(data.get('email') ?? '');
    const message = String(data.get('message') ?? '');
    const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
    window.location.href =
      `mailto:lamkenneth89@gmail.com` +
      `?subject=${encodeURIComponent('Contact from portfolio')}` +
      `&body=${encodeURIComponent(body)}`;
  });
</script>
