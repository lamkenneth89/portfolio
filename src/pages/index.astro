---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import FeaturedEntry from '../components/FeaturedEntry.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site, facts } from '../lib/site';
import { url, imageSet } from '../lib/url';
import { CATEGORIES } from '../content.config';

const all = await getCollection('projects');
const sorted = [...all].sort((a, b) => a.data.order - b.data.order);
const featured = sorted
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.featuredRank - b.data.featuredRank);

// The heading counts what is actually featured, so adding a project in a later
// phase can never leave the page claiming the wrong number.
const NUMBER_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six'];
const featuredWord = NUMBER_WORDS[featured.length] ?? String(featured.length);

const byCategory = CATEGORIES.map((category) => ({
  category,
  items: sorted.filter((p) => p.data.category === category),
})).filter((g) => g.items.length > 0);

const capabilities = [
  {
    heading: 'Data & cloud',
    items: ['Python', 'SQL', 'GCP BigQuery', 'Databricks', 'Alteryx'],
  },
  {
    heading: 'Analysis & visualisation',
    items: ['Tableau', 'Power BI', 'Looker', 'Excel'],
  },
  {
    heading: 'Martech & CRM',
    items: [
      'Adobe Experience Cloud',
      'Salesforce',
      'GA4',
      'Google Tag Manager',
      'Firebase Analytics',
    ],
  },
  {
    heading: 'Build & AI',
    items: [
      'Claude Code',
      'Astro',
      'Kotlin / Compose',
      'Streamlit',
      'Godot',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Analytics & CRM lead',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  url: new URL(url('/'), Astro.site).href,
  sameAs: site.socials.map((s) => s.href),
};
---

<Base title={`${site.name} — ${site.role}`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-[80rem] px-5 sm:px-8">
    <!-- ── Hero ───────────────────────────────────────────────────────── -->
    <section class="grid gap-10 pb-20 pt-16 md:grid-cols-12 md:gap-12 md:pt-24">
      <div class="md:col-span-8">
        <p class="kicker reveal" style="--i:0">
          Analytics · CRM · AI-assisted engineering
        </p>

        <h1
          class="reveal mt-6 text-[clamp(2.7rem,7.2vw,5.4rem)]"
          style="--i:1"
        >
          I turn messy customer data into decisions{' '}
          <em class="text-accent">— and, lately, into software that ships.</em>
        </h1>

        <p
          class="reveal mt-8 max-w-[58ch] text-lg text-fg-muted"
          style="--i:2"
        >
          Fifteen years of consumer insight, business intelligence and CRM at
          Dyson, PCCW and Mattel — doubling a CRM base in a year, and lifting
          incremental repurchase past 20% by treating segmentation as an
          operating system rather than a slide. The last year has been spent
          building the things I used to specify: speech pipelines, instrumented
          mobile apps, dashboards and a game, most of them written alongside an
          AI pair.
        </p>

        <div class="reveal mt-9 flex flex-wrap gap-3" style="--i:3">
          <a
            href={site.resume}
            target="_blank"
            rel="noopener"
            class="border border-accent bg-accent px-5 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-accent-fg no-underline transition-opacity hover:opacity-85"
            data-track="resume_download"
          >
            Download résumé ↗
          </a>
          <a
            href="#work"
            class="border border-rule-strong px-5 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] no-underline transition-colors hover:border-accent hover:text-accent"
          >
            Selected work
          </a>
        </div>
      </div>

      <!-- Dossier column -->
      <aside class="reveal self-end md:col-span-4" style="--i:4">
        <img
          {...imageSet('/images/avatar.jpg')}
          sizes="144px"
          alt={`Portrait of ${site.name}`}
          width="2048"
          height="2048"
          class="mb-7 aspect-square w-28 border border-rule object-cover grayscale md:w-36"
        />
        <dl class="border-t border-rule">
          {
            facts.map((f) => (
              <div class="flex justify-between gap-4 border-b border-rule py-2.5">
                <dt class="kicker pt-0.5">{f.label}</dt>
                <dd class="text-right text-[0.9rem]">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </section>

    <!-- ── Selected work ──────────────────────────────────────────────── -->
    <section id="work" class="scroll-mt-16 pb-20" data-section="work">
      <SectionHead
        num="01"
        label="Selected work"
        title={`${featuredWord.charAt(0).toUpperCase()}${featuredWord.slice(1)} that show the range`}
        note={`${sorted.length} projects in the index`}
      />
      <div class="mt-14 space-y-20">
        {
          featured.map((project, i) => (
            <FeaturedEntry project={project} index={i} />
          ))
        }
      </div>
    </section>

    <!-- ── Full index ─────────────────────────────────────────────────── -->
    <section id="index" class="scroll-mt-16 pb-20" data-section="index">
      <SectionHead num="02" label="Index" title="Everything, by discipline" />
      <div class="mt-12 space-y-14">
        {
          byCategory.map((group) => (
            <div>
              <h3 class="kicker border-b border-rule-strong pb-2">
                {group.category}
                <span class="text-fg-faint">
                  {' '}
                  — {group.items.length}
                </span>
              </h3>
              <ol class="mt-1">
                {group.items.map((project, i) => (
                  <ProjectRow project={project} index={i} />
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Capabilities ───────────────────────────────────────────────── -->
    <section id="capabilities" class="scroll-mt-16 pb-20" data-section="capabilities">
      <SectionHead num="03" label="Capabilities" title="The toolkit" />
      <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((c) => (
            <div class="border-t border-rule-strong pt-4">
              <h3 class="kicker">{c.heading}</h3>
              <ul class="mt-4 space-y-1.5">
                {c.items.map((item) => (
                  <li class="text-[0.95rem]">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── Contact ────────────────────────────────────────────────────── -->
    <section id="contact" class="scroll-mt-16 pb-24" data-section="contact">
      <SectionHead num="04" label="Contact" title="Get in touch" />
      <div class="mt-10 grid gap-10 md:grid-cols-12">
        <form id="contact-form" class="md:col-span-7">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="kicker">Name</span>
              <input
                type="text"
                name="name"
                required
                class="mt-2 w-full border border-rule bg-surface-2 px-3 py-2.5 text-[0.95rem] outline-none focus:border-accent"
              />
            </label>
            <label class="block">
              <span class="kicker">Email</span>
              <input
                type="email"
                name="email"
                required
                class="mt-2 w-full border border-rule bg-surface-2 px-3 py-2.5 text-[0.95rem] outline-none focus:border-accent"
              />
            </label>
          </div>
          <label class="mt-4 block">
            <span class="kicker">Message</span>
            <textarea
              name="message"
              rows="5"
              required
              class="mt-2 w-full border border-rule bg-surface-2 px-3 py-2.5 text-[0.95rem] outline-none focus:border-accent"
            ></textarea>
          </label>
          <button
            type="submit"
            class="mt-5 border border-accent bg-accent px-5 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-accent-fg transition-opacity hover:opacity-85"
          >
            Open in mail client →
          </button>
          <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-fg-faint">
            This form composes a message in your own mail app — nothing is sent
            to a server, and nothing is stored here.
          </p>
        </form>

        <div class="md:col-span-5">
          <p class="font-display text-[clamp(1.6rem,3vw,2.2rem)] leading-tight">
            Happiest on problems where the data is messy, the stakeholders
            disagree, and someone still has to decide.
          </p>
          <ul class="mt-7 border-t border-rule">
            <li class="flex justify-between border-b border-rule py-2.5">
              <span class="kicker pt-0.5">Email</span>
              <a
                href={`mailto:${site.email}`}
                class="text-[0.9rem] hover:text-accent"
                data-track="contact_submit"
                data-contact-method="mailto_link">{site.email}</a
              >
            </li>
            {
              site.socials.map((s) => (
                <li class="flex justify-between border-b border-rule py-2.5">
                  <span class="kicker pt-0.5">{s.label}</span>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener"
                    class="text-[0.9rem] hover:text-accent"
                  >
                    Visit ↗
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  import { track } from '../lib/track';

  // The contact form has no backend by design — it hands the draft to the
  // visitor's own mail client, exactly as the previous site did.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    // Only the channel is recorded — never the name, address or message.
    track('contact_submit', { contact_method: 'form' });
    const data = new FormData(form);
    const name = String(data.get('name') ?? '');
    const email = String(data.get('email') ?? '');
    const message = String(data.get('message') ?? '');
    const body = `Name: ${name}\nEmail: ${email}\n\n${message}`;
    window.location.href =
      `mailto:lamkenneth89@gmail.com` +
      `?subject=${encodeURIComponent('Contact from portfolio')}` +
      `&body=${encodeURIComponent(body)}`;
  });
</script>
