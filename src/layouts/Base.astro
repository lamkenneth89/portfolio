---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative path to the social preview image. */
  ogImage?: string;
  /** Rendered into <head> as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.tagline,
  ogImage = '/images/avatar.jpg',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : new URL(url(ogImage), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400&display=swap"
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    {/* Theme is applied before first paint so the page never flashes. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* private mode — fall through to prefers-color-scheme */
        }
      })();
    </script>

    {/* Consent Mode v2 defaults, set before any container loads. Nothing is
        measured until the visitor opts in through the banner. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>

    {/* Nothing Google-owned is requested until the visitor opts in. Consent
        Mode alone would still let a denied-state cookieless ping leave the
        browser; withholding the tag entirely means genuinely zero hits.
        ConsentBanner calls this once consent exists. */}
    <script is:inline define:vars={{ gtm: site.gtm, ga4: site.ga4 }}>
      window.__loadAnalytics = function () {
        if (window.__analyticsLoaded) return;
        window.__analyticsLoaded = true;

        var script = document.createElement('script');
        script.async = true;

        if (gtm) {
          dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          script.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm;
        } else {
          // No container configured yet — keep the existing GA4 tag working.
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
          gtag('js', new Date());
          gtag('config', ga4);
        }
        document.head.appendChild(script);
      };
    </script>
  </head>

  <body>
    {
      site.gtm && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${site.gtm}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>

<script>
  import { initTracking } from '../lib/track';
  initTracking();
</script>
