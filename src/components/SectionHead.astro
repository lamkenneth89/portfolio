---
interface Props {
  num: string;
  label: string;
  title?: string;
  note?: string;
}
const { num, label, title, note } = Astro.props;
---

<div>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p class="kicker flex items-center gap-2.5">
      <span
        class="grid h-7 w-7 place-items-center rounded-full bg-brand-soft font-display text-[0.9rem] normal-case tracking-normal text-accent"
        >{num}</span
      >
      {label}
    </p>
    {note && <p class="text-[0.88rem] text-fg-faint">{note}</p>}
  </div>
  {title && <h2 class="mt-4 text-[clamp(2rem,4.4vw,3rem)]">{title}</h2>}
</div>
