---
interface Props {
  num: string;
  label: string;
  title?: string;
  note?: string;
}
const { num, label, title, note } = Astro.props;
---

<div class="rule-top pt-4">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <p class="kicker">§ {num} &nbsp;/&nbsp; {label}</p>
    {note && <p class="kicker">{note}</p>}
  </div>
  {title && <h2 class="mt-5 text-[clamp(2.1rem,5vw,3.4rem)]">{title}</h2>}
</div>
