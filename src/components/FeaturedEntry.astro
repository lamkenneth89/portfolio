---
import { url, imageSet, resolveDestination } from '../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const d = project.data;

const href = d.hasCaseStudy
  ? url(`/projects/${project.id}`)
  : d.external
    ? resolveDestination(d.external)
    : undefined;
const isOutbound = href ? /^https?:/.test(href) : false;
const flip = index % 2 === 1;
---

<article class="grid items-center gap-6 md:grid-cols-12 md:gap-10">
  <a
    href={href}
    target={isOutbound ? '_blank' : undefined}
    rel={isOutbound ? 'noopener' : undefined}
    class:list={[
      'group block overflow-hidden border border-rule md:col-span-7',
      flip ? 'md:order-2 md:col-start-6' : '',
    ]}
    tabindex="-1"
    aria-hidden="true"
    data-track="project_card_click"
    data-project-id={project.id}
    data-project-category={d.category}
    data-destination-type={d.hasCaseStudy ? 'case_study' : 'external'}
  >
    {
      d.thumb && (
        <img
          {...imageSet(d.thumb)}
          sizes="(min-width: 768px) 58vw, 100vw"
          alt=""
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      )
    }
  </a>

  <div class:list={['md:col-span-5', flip ? 'md:order-1 md:col-start-1' : '']}>
    <p class="kicker">
      {d.category}
      {d.period ? ` · ${d.period}` : ''}
    </p>
    <h3 class="mt-3 text-[clamp(1.9rem,3.6vw,2.9rem)]">
      <a
        href={href}
        target={isOutbound ? '_blank' : undefined}
        rel={isOutbound ? 'noopener' : undefined}
        class="no-underline transition-colors hover:text-accent"
        data-track="project_card_click"
        data-project-id={project.id}
        data-project-category={d.category}
        data-destination-type={d.hasCaseStudy ? 'case_study' : 'external'}
      >
        {d.title}
      </a>
    </h3>
    <p class="mt-3 text-fg-muted">{d.summary}</p>

    {
      d.metrics.length > 0 && (
        <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
          {d.metrics.map((m) => (
            <div>
              <dt class="font-display text-3xl leading-none text-accent">
                {m.value}
              </dt>
              <dd class="kicker mt-1.5">{m.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      d.stack.length > 0 && (
        <p class="mt-5 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-fg-faint">
          {d.stack.join(' · ')}
        </p>
      )
    }
  </div>
</article>
