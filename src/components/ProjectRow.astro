---
import { url, imageSet, resolveDestination } from '../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const d = project.data;

// A case study when one is written, otherwise the original destination —
// a Tableau Public viz, a GitHub repo, or the full-size chart.
const href = d.hasCaseStudy
  ? url(`/projects/${project.id}`)
  : d.external
    ? resolveDestination(d.external)
    : undefined;

const isOutbound = href ? /^https?:/.test(href) : false;
const destination = d.hasCaseStudy
  ? 'case_study'
  : isOutbound
    ? 'external'
    : 'image';
const num = String(index + 1).padStart(2, '0');
---

<li class="border-b border-rule/70 last:border-b-0">
  <a
    href={href}
    target={isOutbound ? '_blank' : undefined}
    rel={isOutbound ? 'noopener' : undefined}
    class="group -mx-3 my-1 grid grid-cols-[2.2rem_1fr] items-start gap-x-3 gap-y-2 rounded-2xl px-3 py-4 no-underline transition-colors duration-300 hover:bg-surface-2 sm:grid-cols-[2.6rem_6rem_1fr_auto] sm:items-center sm:gap-x-5"
    data-track="project_card_click"
    data-project-id={project.id}
    data-project-category={d.category}
    data-destination-type={destination}
  >
    <span
      class="pt-1 font-display text-lg text-fg-faint transition-colors group-hover:text-accent sm:pt-0"
    >
      {num}
    </span>

    {
      // The index is for scanning; on a phone eighteen full-width thumbnails
      // would turn it into a very long scroll, so the image is desktop-only.
      d.thumb && (
        <span class="col-start-2 row-start-1 hidden overflow-hidden rounded-lg border border-rule sm:block sm:w-[6rem]">
          <img
            {...imageSet(d.thumb)}
            sizes="88px"
            alt=""
            loading="lazy"
            decoding="async"
            class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.05]"
          />
        </span>
      )
    }

    <span class="col-start-2 row-start-1 block sm:col-start-3">
      <span
        class="block font-display text-[1.35rem] leading-snug transition-colors group-hover:text-accent sm:text-[1.5rem]"
      >
        {d.title}
      </span>
      <span class="mt-1 block max-w-[58ch] text-[0.97rem] text-fg-muted">
        {d.summary}
      </span>
      {
        d.stack.length > 0 && (
          <span class="mt-1.5 block text-[0.84rem] text-fg-faint">
            {d.stack.join(' · ')}
          </span>
        )
      }
    </span>

    <span
      class="col-start-2 hidden h-9 w-9 place-items-center rounded-full bg-surface-3/60 text-sm text-fg-faint transition duration-300 group-hover:translate-x-1 group-hover:bg-brand-soft group-hover:text-accent sm:col-start-4 sm:grid"
      aria-hidden="true"
    >
      {isOutbound ? '↗' : '→'}
    </span>
  </a>
</li>
