---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-surface-2/70">
  <div
    class="mx-auto flex max-w-[76rem] flex-col gap-6 px-5 py-12 sm:flex-row sm:items-end sm:justify-between sm:px-8"
  >
    <div>
      <p class="kicker">Open to conversations — {site.location}</p>
      <p class="mt-3 font-display text-[clamp(1.6rem,3.4vw,2.2rem)] leading-none">
        <a href={`mailto:${site.email}`} class="no-underline hover:text-accent">
          {site.email}
        </a>
      </p>
    </div>

    <ul class="flex flex-wrap gap-2">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="btn btn-ghost btn-sm"
            >
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-rule">
    <div
      class="mx-auto flex max-w-[76rem] flex-wrap justify-between gap-3 px-5 py-4 text-[0.82rem] text-fg-faint sm:px-8"
    >
      <span>&copy; {year} Kenneth Lam</span>
      <span>Built with Astro · Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
