---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-rule">
  <div
    class="mx-auto flex max-w-[80rem] flex-col gap-6 px-5 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-8"
  >
    <div>
      <p class="font-display text-3xl leading-none">
        <a href={`mailto:${site.email}`} class="no-underline hover:text-accent">
          {site.email}
        </a>
      </p>
      <p class="kicker mt-3">Open to conversations — {site.location}</p>
    </div>

    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-fg-muted no-underline hover:text-accent"
            >
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-rule">
    <div
      class="mx-auto flex max-w-[80rem] flex-wrap justify-between gap-3 px-5 py-4 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-fg-faint sm:px-8"
    >
      <span>&copy; {year} Kenneth Lam</span>
      <span>Built with Astro · Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
