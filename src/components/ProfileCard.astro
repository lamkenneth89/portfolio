---
import { site, facts } from '../lib/site';
import { imageSet } from '../lib/url';

interface Props {
  /** Show the fact list under the name (home page). */
  withFacts?: boolean;
}
const { withFacts = true } = Astro.props;
---

<!-- The old site's left sidebar, brought forward: the Mt Fuji photo it used as
     a backdrop, with the portrait and name set on top of it. -->
<div
  class="relative isolate overflow-hidden rounded-[1.4rem] bg-strata-brown px-6 pb-6 pt-9 text-center text-white shadow-[0_24px_50px_-26px_rgb(30_20_12/0.55)]"
>
  {/* Taller than the card and anchored to its bottom: the photo fills the
      card by height, so object-position cannot move it vertically. Oversizing
      lifts the Fuji summit above the fact panel instead of behind it. */}
  <img
    {...imageSet('/images/bg.jpg')}
    sizes="(min-width: 768px) 30vw, 100vw"
    alt=""
    loading="eager"
    decoding="async"
    class="absolute inset-x-0 bottom-0 -z-20 h-[150%] w-full object-cover object-bottom"
  />
  {/* Warm brown wash, heavier towards the bottom: keeps white text legible
      over a bright sky and pulls the cool photo into the warm palette. */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-[rgb(31_24_21/0.14)] via-[rgb(31_24_21/0.22)] to-[rgb(31_24_21/0.62)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto w-36 rounded-full bg-gradient-to-br from-brand to-[#f4b680] p-[4px] md:w-40"
  >
    <img
      {...imageSet('/images/avatar.jpg')}
      sizes="160px"
      alt={`Portrait of ${site.name}`}
      width="1024"
      height="1024"
      class="aspect-square w-full rounded-full border-4 border-white/90 object-cover"
    />
  </div>
  <p class="mt-4 font-display text-2xl [text-shadow:0_1px_12px_rgb(0_0_0/0.35)]">
    {site.name}
  </p>
  <p class="text-[0.93rem] text-white/85 [text-shadow:0_1px_8px_rgb(0_0_0/0.35)]">
    {site.role}
  </p>

  {/* Without the fact list the card is too short for the summit to clear the
      portrait, so leave room for it — much as the old sidebar did. */}
  {!withFacts && <div class="h-60" aria-hidden="true" />}

  {
    withFacts && (
      <dl class="mt-24 rounded-2xl bg-[rgb(31_24_21/0.52)] px-4 py-1 text-left backdrop-blur-md">
        {facts.map((f, i) => (
          <div
            class:list={[
              'flex justify-between gap-4 py-2.5',
              i > 0 && 'border-t border-white/15',
            ]}
          >
            <dt class="pt-0.5 text-[0.72rem] font-semibold uppercase tracking-[0.12em] text-white/70">
              {f.label}
            </dt>
            <dd class="text-right text-[0.92rem]">{f.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>
