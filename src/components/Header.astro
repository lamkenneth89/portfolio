---
import { site } from '../lib/site';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="sticky top-0 z-40 border-b border-rule/70 bg-surface/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-[76rem] items-center justify-between gap-3 px-4 py-3 sm:gap-6 sm:px-8 sm:py-3.5"
  >
    <a
      href={url('/')}
      class="shrink-0 whitespace-nowrap font-display text-[1.05rem] no-underline transition-colors hover:text-accent sm:text-lg"
    >
      Kenneth Lam
      <span class="ml-1 hidden font-body text-sm text-fg-faint sm:inline">
        · {site.location}
      </span>
    </a>

    <nav class="flex items-center sm:gap-2" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={url(item.href)}
            class="rounded-full px-2 py-1.5 text-[0.88rem] font-medium sm:px-3 sm:text-[0.93rem] text-fg-muted no-underline transition-colors hover:bg-brand-soft hover:text-accent"
          >
            {item.label}
          </a>
        ))
      }
      <span class="ml-1"><ThemeToggle /></span>
    </nav>
  </div>
</header>
