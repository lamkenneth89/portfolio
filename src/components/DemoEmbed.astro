---
import { url, imageSet } from '../lib/url';

interface Props {
  demo: {
    type: 'iframe' | 'link' | 'video' | 'image';
    url: string;
    label?: string;
    fallbackImage?: string;
  };
  projectId: string;
}

const { demo, projectId } = Astro.props;
const label = demo.label ?? 'Open the live app';
const src = /^https?:/.test(demo.url) ? demo.url : url(encodeURI(demo.url));
// Must go through imageSet: the originals live outside the deploy, so a raw
// /images/thumbs/… path 404s in production.
const fallback = demo.fallbackImage ? imageSet(demo.fallbackImage) : undefined;
---

<figure class="mt-14">
  <figcaption
    class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule-strong pb-2"
  >
    <span class="kicker">Try it yourself</span>
    <a
      href={src}
      target="_blank"
      rel="noopener"
      class="text-[0.93rem] font-semibold text-accent no-underline hover:underline"
      data-track="demo_interaction"
      data-demo-id={projectId}
      data-demo-action="open_in_new_tab"
    >
      {label} ↗
    </a>
  </figcaption>

  {
    demo.type === 'iframe' && (
      <div
        class="mt-4"
        data-demo-frame
        data-demo-id={projectId}
        data-demo-src={src}
      >
        {/* Loaded on demand: these embeds are heavy and must not cost the
            page its first paint. */}
        <button
          type="button"
          class="group frame relative block w-full"
          data-demo-start
        >
          {fallback ? (
            <img
              {...fallback}
              sizes="(min-width: 768px) 70vw, 100vw"
              alt=""
              loading="lazy"
              decoding="async"
              class="aspect-[16/10] w-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.02] group-hover:opacity-100"
            />
          ) : (
            <span class="block aspect-[16/10] w-full bg-surface-2" />
          )}
          <span class="absolute inset-0 grid place-items-center">
            <span class="btn btn-primary">
              ▶ Load the live demo
            </span>
          </span>
        </button>
      </div>
    )
  }

  {
    demo.type === 'video' && (
      <video
        class="frame mt-4 w-full"
        controls
        preload="none"
        poster={fallback?.src}
        data-track="demo_interaction"
        data-demo-id={projectId}
        data-demo-action="play_video"
      >
        <source src={src} type="video/mp4" />
      </video>
    )
  }

  {
    demo.type === 'image' && (
      <img
        src={src}
        alt=""
        loading="lazy"
        decoding="async"
        class="frame mt-4 w-full"
      />
    )
  }

  {
    demo.type === 'link' && (
      <a
        href={src}
        target="_blank"
        rel="noopener"
        class="panel mt-4 flex items-center justify-between px-6 py-6 no-underline transition-colors hover:border-accent"
        data-track="demo_interaction"
        data-demo-id={projectId}
        data-demo-action="open_in_new_tab"
      >
        <span class="font-display text-2xl">{label}</span>
        <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-soft text-accent">↗</span>
      </a>
    )
  }
</figure>

<script>
  import { track } from '../lib/track';

  // Swap the poster for the real iframe only once the visitor asks for it.
  document.querySelectorAll('[data-demo-frame]').forEach((wrap) => {
    const button = wrap.querySelector('[data-demo-start]');
    button?.addEventListener('click', () => {
      const src = (wrap as HTMLElement).dataset.demoSrc;
      const id = (wrap as HTMLElement).dataset.demoId ?? '';
      if (!src) return;

      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = 'Live demo';
      frame.loading = 'lazy';
      frame.allowFullscreen = true;
      frame.className = 'frame aspect-[16/10] w-full';
      wrap.replaceChildren(frame);
      track('demo_interaction', { demo_id: id, demo_action: 'load_embed' });
    });
  });
</script>
